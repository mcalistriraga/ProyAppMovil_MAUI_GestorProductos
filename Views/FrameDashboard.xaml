<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppGestorMovil.Views.FrameDashboard"
             BackgroundColor="#849EDE"
             Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout Padding="24,40,24,24" Spacing="36">

            <!-- Encabezado: logo + nombre -->
            <HorizontalStackLayout Spacing="18" HorizontalOptions="Start">
                <Image Source="logo_empresa.png"
                       WidthRequest="60"
                       HeightRequest="90"
                       VerticalOptions="Start"/>
                <VerticalStackLayout Spacing="4" VerticalOptions="Start">
                    <Label Text="StockMaster"
                           FontSize="44"
                           FontAttributes="Bold"
                           TextColor="#FBA4A4"
                           HorizontalOptions="Start"/>
                    <Label Text="Gestión Eficiente de Inventarios"
                           FontSize="16"
                           TextColor="#E6BFE7"
                           HorizontalOptions="Start"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <!-- Botones alineados verticalmente a la izquierda -->
            <HorizontalStackLayout HorizontalOptions="Start">
                <VerticalStackLayout WidthRequest="240" Spacing="20">

                    <!-- Botón: Productos -->
                    <Frame CornerRadius="16"
                           BackgroundColor="#E1E8FB"
                           HasShadow="True"
                           Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Productos"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#333"/>
                            <Button Text="Ir"
                                    Command="{Binding DashboardOptions[0].Command}"
                                    BackgroundColor="#FF9800"
                                    TextColor="White"
                                    CornerRadius="8"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Botón: Categorías -->
                    <Frame CornerRadius="16"
                           BackgroundColor="#E1E8FB"
                           HasShadow="True"
                           Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Categorías"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#333"/>
                            <Button Text="Ir"
                                    Command="{Binding DashboardOptions[1].Command}"
                                    BackgroundColor="#2196F3"
                                    TextColor="White"
                                    CornerRadius="8"/>
                        </VerticalStackLayout>
                    </Frame>

                    <!-- Botón: Buscar -->
                    <Frame CornerRadius="16"
                           BackgroundColor="#E1E8FB"
                           HasShadow="True"
                           Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Buscar"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   TextColor="#333"/>
                            <Button Text="Ir"
                                    Command="{Binding DashboardOptions[2].Command}"
                                    BackgroundColor="#4CAF50"
                                    TextColor="White"
                                    CornerRadius="8"/>
                        </VerticalStackLayout>
                    </Frame>

                </VerticalStackLayout>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
