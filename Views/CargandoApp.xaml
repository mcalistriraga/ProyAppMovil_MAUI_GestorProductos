<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppGestorMovil.Views.CargandoApp"
             BackgroundColor="#849DE0">

    <VerticalStackLayout 
        VerticalOptions="CenterAndExpand"
        HorizontalOptions="Center"
        Spacing="30">

        <Image Source="img_LogoEmpresa.png"
               WidthRequest="100"
               HeightRequest="147"
               HorizontalOptions="Center" />

        <Label Text="loading..."
               TextColor="White"
               FontSize="18"
               HorizontalOptions="Center" />

        <ActivityIndicator IsRunning="True"
                           Color="White"
                           WidthRequest="40"
                           HeightRequest="40"
                           HorizontalOptions="Center" />
    </VerticalStackLayout>

</ContentPage>
