<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MauiAppGestorMovil.Views"
             xmlns:converters="clr-namespace:MauiAppGestorMovil.Converters"
             x:Class="MauiAppGestorMovil.Views.GestionDeCategorias"
             BackgroundColor="#849EDE">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:IntToBoolConverter x:Key="IntToBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Encabezado reutilizable -->
            <views:EncabezadoEmpresa TituloPagina="Gestión de Categorías" />

            <!-- Botón Agregar Categoría -->
            <Frame BackgroundColor="#5779EA"
                   CornerRadius="10"
                   Padding="5"
                   HasShadow="True"
                   HeightRequest="40"
                   WidthRequest="200"
                   HorizontalOptions="Start">
                <Grid>
                    <Button Text="+ Agregar Categoría"
                            BackgroundColor="Transparent"
                            TextColor="White"
                            FontFamily="Inter"
                            FontAttributes="Bold"
                            Clicked="AgregarCategoria_Clicked"/>
                </Grid>
            </Frame>

            <!-- Lista de Categorías -->
            <CollectionView x:Name="CategoriasCollection"
                            ItemsSource="{Binding CategoriasJerarquicas}"
                            SelectionMode="None">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <StackLayout Spacing="10">

                            <!-- Contenedor de categoría -->
                            <Frame BackgroundColor="#E1E8FB"
                                   CornerRadius="10"
                                   Padding="10"
                                   HasShadow="True">

                                <Grid ColumnDefinitions="*, Auto, Auto, Auto"
                                      VerticalOptions="Center"
                                      Padding="0">

                                    <!-- Nombre de la categoría -->
                                    <Label Grid.Column="0"
                                           Text="{Binding Categoria.Nombre}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           VerticalOptions="Center"
                                           TextColor="Black"/>

                                    <!-- Botón +Sub -->
                                    <Button Grid.Column="1"
                                            Text="+ Sub"
                                            BackgroundColor="#5779EA"
                                            TextColor="White"
                                            FontSize="12"
                                            HeightRequest="30"
                                            WidthRequest="60"
                                            CornerRadius="5"
                                            Clicked="AgregarSubcategoria_Clicked"
                                            CommandParameter="{Binding .}"/>

                                    <!-- Icono editar -->
                                    <ImageButton Grid.Column="2"
                                                 Source="iconoeditar_01.png"
                                                 WidthRequest="25"
                                                 HeightRequest="25"
                                                 BackgroundColor="Transparent"
                                                 Clicked="EditarCategoria_Clicked"
                                                 CommandParameter="{Binding .}"/>

                                    <!-- Icono eliminar -->
                                    <ImageButton Grid.Column="3"
                                                 Source="iconoeliminar_01.png"
                                                 WidthRequest="25"
                                                 HeightRequest="25"
                                                 BackgroundColor="Transparent"
                                                 Clicked="EliminarCategoria_Clicked"
                                                 CommandParameter="{Binding .}"/>
                                </Grid>

                                <!-- Subcategorías si existen -->
                                <StackLayout Padding="10,5,0,0" Spacing="5"
                                             IsVisible="{Binding Subcategorias.Count, Converter={StaticResource IntToBoolConverter}}">
                                    <Label Text="Subcategorías:"
                                           FontSize="13"
                                           TextColor="Gray"
                                           FontAttributes="Italic"/>
                                    <CollectionView ItemsSource="{Binding Subcategorias}"
                                                    SelectionMode="None">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Label Text="{Binding Categoria.Nombre}"
                                                       FontSize="14"
                                                       TextColor="#444444"/>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                    </CollectionView>
                                </StackLayout>

                            </Frame>
                        </StackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
