<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppGestorMovil.Views.GestionDeCategorias"
             xmlns:views="clr-namespace:MauiAppGestorMovil.Views"
             BackgroundColor="#849EDE"
             Title="Gestión de Categorías">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Encabezado reutilizable -->
            <views:EncabezadoEmpresa TituloPagina="Gestión de Categorías" />

            <!-- Título -->
            <Label Text="Categorías disponibles"
                   FontSize="18"
                   FontAttributes="Bold"
                   FontFamily="Inter"
                   TextColor="White" />

            <!-- Lista de categorías jerárquicas -->
            <CollectionView ItemsSource="{Binding CategoriasJerarquicas}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#5A7DC5"
                               CornerRadius="10"
                               Padding="10"
                               Margin="5">
                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto">

                                <!-- Nombre de categoría -->
                                <Label Text="{Binding Categoria.Nombre}"
                                       FontFamily="Inter"
                                       FontSize="16"
                                       TextColor="White"
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       VerticalOptions="Center" />

                                <!-- Botones de acción -->
                                <HorizontalStackLayout Spacing="10"
                                                       Grid.Row="0"
                                                       Grid.Column="1"
                                                       HorizontalOptions="End">

                                    <!-- Botón: Agregar Subcategoría -->
                                    <Button Text="+Sub"
                                            FontSize="12"
                                            Padding="4"
                                            BackgroundColor="#33C2FF"
                                            TextColor="White"
                                            Clicked="AgregarSubcategoria_Clicked"
                                            />

                                    <!-- Botón: Editar -->
                                    <ImageButton Source="iconoeditar_01.png"
                                                 WidthRequest="28"
                                                 HeightRequest="28"
                                                 BackgroundColor="Transparent"
                                                 Clicked="EditarCategoria_Clicked"
                                                 SemanticProperties.Hint="Editar categoría" />

                                    <!-- Botón: Eliminar -->
                                    <ImageButton Source="iconoeliminar_01.png"
                                                 WidthRequest="28"
                                                 HeightRequest="28"
                                                 BackgroundColor="Transparent"
                                                 Clicked="EliminarCategoria_Clicked"
                                                 SemanticProperties.Hint="Eliminar categoría" />
                                </HorizontalStackLayout>

                                <!-- Subcategorías -->
                                <CollectionView ItemsSource="{Binding Subcategorias}"
                                                Grid.Row="1"
                                                Grid.ColumnSpan="2"
                                                Margin="10,5,0,0">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Label Text="↳ {Binding Categoria.Nombre}"
                                                   FontFamily="Inter"
                                                   FontSize="14"
                                                   TextColor="White"
                                                   Margin="10,2" />
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                            </Grid>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
