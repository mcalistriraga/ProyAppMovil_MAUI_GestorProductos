<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MauiAppGestorMovil.Views"
             xmlns:controls="clr-namespace:MauiAppGestorMovil.Controls"
             xmlns:viewcontrols="clr-namespace:MauiAppGestorMovil.Views.Controls"
             x:Class="MauiAppGestorMovil.Views.GestionDeCategorias"
             BackgroundColor="#849EDE">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Encabezado reutilizable -->
            <views:EncabezadoEmpresa TituloPagina="Gestión de Categorías" />

            <!-- Botón Agregar Categoría -->
            <Frame CornerRadius="10"
                   BackgroundColor="#5679EA"
                   HasShadow="True"
                   Padding="0"
                   HeightRequest="37"
                   WidthRequest="169"
                   Margin="206,0,0,0"
                   HorizontalOptions="Start">
                <Grid VerticalOptions="Center" HorizontalOptions="Center">
                    <Button Text="+ Agregar Categoría"
                            BackgroundColor="#5679EA"
                            TextColor="White"
                            FontSize="15"
                            FontAttributes="Bold"
                            FontFamily="Inter"
                            CornerRadius="10"
                            Padding="0"
                            Clicked="AgregarCategoria_Clicked"/>
                </Grid>
            </Frame>

            <!-- Lista de Categorías usando control recursivo -->
            <CollectionView x:Name="CategoriasCollection"
                            ItemsSource="{Binding CategoriasJerarquicas}"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <viewcontrols:CategoriaItemView PaddingLeftExtra="0" />
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
