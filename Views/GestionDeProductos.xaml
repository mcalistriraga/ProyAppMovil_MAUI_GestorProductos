<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MauiAppGestorMovil.Views"
             xmlns:controls="clr-namespace:MauiAppGestorMovil.Controls"
             x:Class="MauiAppGestorMovil.Views.GestionDeProductos"
             Title="Gestión de Productos"
             BackgroundColor="#849DE0">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Encabezado reutilizable -->
            <views:EncabezadoEmpresa TituloPagina="Gestión de Productos..." />

            <!-- Botón Agregar Producto -->
            <Frame CornerRadius="10"
                   BackgroundColor="#5679EA"
                   HasShadow="True"
                   Padding="0"
                   HeightRequest="37"
                   WidthRequest="169"
                   Margin="206,0,0,0"
                   HorizontalOptions="Start">
                <Grid VerticalOptions="Center" HorizontalOptions="Center">
                    <Button Text="+ Agregar Producto"
                            BackgroundColor="#5679EA"
                            TextColor="White"
                            FontSize="15"
                            FontAttributes="Bold"
                            FontFamily="Inter"
                            CornerRadius="10"
                            Padding="0"
                            Command="{Binding AgregarProductoCommand}" />
                </Grid>
            </Frame>

            <!-- Lista de productos -->
            <CollectionView x:Name="cvProductos"
                            ItemsSource="{Binding Productos}"
                            BackgroundColor="Transparent">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame CornerRadius="10"
                               Padding="10"
                               Margin="0,2"
                               BackgroundColor="#E1E8FB"
                               HasShadow="True">
                            <StackLayout Spacing="4">
                                <Label Text="{Binding Nombre}"
                                       FontAttributes="Bold"
                                       FontSize="18"
                                       TextColor="Black" />

                                <Label Text="{Binding Descripcion}"
                                       FontSize="14"
                                       TextColor="Black"
                                       FontFamily="Inter" />

                                <Label Text="{Binding CategoriaNombre, StringFormat='Categoría: {0}'}"
                                       FontSize="13"
                                       TextColor="Black"
                                       FontFamily="Inter" />

                                <Label Text="{Binding Precio, StringFormat='Precio: Bs {0:F2}'}"
                                       FontSize="13"
                                       TextColor="Black"
                                       FontFamily="Inter" />

                                <Label Text="{Binding Stock, StringFormat='Stock: {0}'}"
                                       FontSize="13"
                                       TextColor="Black"
                                       FontFamily="Inter" />

                                <!-- Controles: Ver, Editar, Eliminar -->
                                <StackLayout Orientation="Horizontal"
                                             HorizontalOptions="End"
                                             Spacing="10"
                                             Margin="0,4,0,0">

                                    <!-- Ver (como imagen) -->
                                    <ImageButton Source="iconover_01.png"
                                                 HeightRequest="55"
                                                 WidthRequest="55"
                                                 BackgroundColor="Transparent"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type views:GestionDeProductos}}, Path=BindingContext.VerProductoCommand}"
                                                 CommandParameter="{Binding .}" />

                                    <!-- Editar -->
                                    <ImageButton Source="iconoeditar_01.png"
                                                 HeightRequest="30"
                                                 WidthRequest="30"
                                                 BackgroundColor="Transparent"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type views:GestionDeProductos}}, Path=BindingContext.EditarProductoCommand}"
                                                 CommandParameter="{Binding .}" />

                                    <!-- Eliminar -->
                                    <ImageButton Source="iconoeliminar_01.png"
                                                 HeightRequest="30"
                                                 WidthRequest="30"
                                                 BackgroundColor="Transparent"
                                                 Command="{Binding Source={RelativeSource AncestorType={x:Type views:GestionDeProductos}}, Path=BindingContext.EliminarProductoCommand}"
                                                 CommandParameter="{Binding .}" />
                                </StackLayout>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
