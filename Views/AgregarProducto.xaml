<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MauiAppGestorMovil.Views"
             x:Class="MauiAppGestorMovil.Views.AgregarProducto"
             Title="Agregar Producto"
             BackgroundColor="#849DE0">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <VerticalStackLayout.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnFondoTocado" NumberOfTapsRequired="1" />
            </VerticalStackLayout.GestureRecognizers>

            <!-- Encabezado -->
            <views:EncabezadoEmpresa TituloPagina="Agregar Producto" />

            <!-- Marco del formulario -->
            <Frame BackgroundColor="#E1E8FB"
                   BorderColor="#5679EA"
                   CornerRadius="0"
                   Padding="20"
                   HasShadow="True">

                <VerticalStackLayout Spacing="15">

                    <!-- Nombre -->
                    <Label Text="Nombre:" TextColor="Black" />
                    <Entry x:Name="entryNombre"
                           BackgroundColor="White"
                           TextColor="Black"
                           Placeholder="Ingrese el nombre"
                           Text="{Binding Nombre}" />

                    <!-- Descripción -->
                    <Label Text="Descripción:" TextColor="Black" />
                    <Editor x:Name="editorDescripcion"
                            BackgroundColor="White"
                            TextColor="Black"
                            AutoSize="TextChanges"
                            HeightRequest="80"
                            Text="{Binding Descripcion}" />

                    <!-- Cantidad -->
                    <Label Text="Stock:" TextColor="Black" />
                    <Entry x:Name="entryCantidad"
                           BackgroundColor="White"
                           TextColor="Black"
                           Keyboard="Numeric"
                           Placeholder="Ingrese cantidad"
                           Text="{Binding Stock}" />

                    <!-- Precio -->
                    <Label Text="Precio:" TextColor="Black" />
                    <Entry x:Name="entryPrecio"
                           BackgroundColor="White"
                           TextColor="Black"
                           Keyboard="Numeric"
                           Placeholder="Ingrese precio"
                           Text="{Binding Precio}" />

                    <!-- Categoría (solo visual) -->
                    <Label Text="Categoría:" TextColor="Black" FontAttributes="Bold" />
                    <Label x:Name="labelRutaCategoria"
                           TextColor="Black"
                           FontAttributes="Italic"
                           FontSize="14"
                           Text="{Binding RutaCategoria}" />

                    <!-- Propiedades Específicas -->
                    <Label Text="Propiedades Específicas:" TextColor="Black" FontAttributes="Bold" Margin="0,10,0,0"/>
                    <VerticalStackLayout x:Name="stackPropiedades" Spacing="10" />

                    <!-- Botones -->
                    <HorizontalStackLayout HorizontalOptions="End" Spacing="10" Margin="0,20,0,0">

                        <Button Text="Guardar"
                                BackgroundColor="#5679EA"
                                TextColor="White"
                                FontAttributes="Bold"
                                WidthRequest="100"
                                HeightRequest="40"
                                CornerRadius="5"
                                Command="{Binding GuardarCommand}" />

                        <Button Text="Cerrar"
                                BackgroundColor="#DA6533"
                                TextColor="White"
                                FontAttributes="Bold"
                                WidthRequest="100"
                                HeightRequest="40"
                                CornerRadius="5"
                                Command="{Binding CancelarCommand}" />

                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>