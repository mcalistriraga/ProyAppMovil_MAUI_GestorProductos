<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiAppGestorMovil.Views"
             x:Class="MauiAppGestorMovil.Views.DetallesDelProducto"
             Title="Detalles del Producto"
             BackgroundColor="#849DE0">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Encabezado reutilizable con título dinámico -->
            <local:EncabezadoEmpresa TituloPagina="Detalles del Producto" />

            <Frame CornerRadius="10"
                   BackgroundColor="#5679EA"
                   Padding="10"
                   Margin="0,10,0,10">
                <VerticalStackLayout Spacing="10">

                    <Label Text="{Binding Nombre}"
                           FontAttributes="Bold"
                           FontSize="24"
                           TextColor="White" />

                    <Label Text="{Binding CategoriaNombreCompleta}"
                           FontSize="14"
                           TextColor="White"
                           FontAttributes="Italic" />

                    <Label Text="{Binding Descripcion}"
                           FontSize="16"
                           TextColor="White" />

                    <Label Text="{Binding Precio, StringFormat='Precio: Bs {0:F2}'}"
                           FontSize="16"
                           TextColor="White" />

                    <Label Text="{Binding Stock, StringFormat='Stock: {0}'}"
                           FontSize="16"
                           TextColor="White" />

                    <Button Text="Cerrar"
                            BackgroundColor="#5779EA"
                            TextColor="White"
                            CornerRadius="10"
                            HeightRequest="40"
                            Clicked="BtnCerrar_Clicked" />
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
