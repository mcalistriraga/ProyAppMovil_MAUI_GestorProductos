<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:MauiAppGestorMovil.Views"
             x:Class="MauiAppGestorMovil.Views.DetallesDelProducto"
             Title="Detalles del Producto"
             BackgroundColor="#849DE0">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Encabezado reutilizable con título dinámico -->
            <local:EncabezadoEmpresa TituloPagina="Detalles del Producto" />

            <!-- Botón pequeño "← Cerrar" arriba -->
            <Frame CornerRadius="10"
                   BackgroundColor="#5779EA"
                   HasShadow="True"
                   Padding="0"
                   HeightRequest="28"
                   WidthRequest="95"
                   HorizontalOptions="Start">
                <Grid VerticalOptions="Center" HorizontalOptions="Center">
                    <Button Text="← Cerrar"
                            BackgroundColor="#5779EA"
                            TextColor="White"
                            FontSize="15"
                            FontAttributes="Bold"
                            FontFamily="Inter"
                            CornerRadius="10"
                            Padding="0"
                            Clicked="BtnCerrar_Clicked" />
                </Grid>
            </Frame>

            <!-- Contenido principal -->
            <Frame CornerRadius="10"
                   BackgroundColor="#E1E8FB"
                   Padding="20"
                   HasShadow="True">

                <VerticalStackLayout Spacing="15">

                    <Label Text="{Binding Nombre}"
                           FontAttributes="Bold"
                           FontSize="24"
                           TextColor="Black"
                           HorizontalOptions="Center" />

                    <Label Text="Categoría:"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="Black" />
                    <Label Text="{Binding CategoriaNombreCompleta}"
                           FontSize="14"
                           TextColor="Black" />

                    <Label Text="Descripción:"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="Black" />
                    <Label Text="{Binding Descripcion}"
                           FontSize="16"
                           TextColor="Black" />

                    <Label Text="Propiedades:"
                           FontAttributes="Bold"
                           FontSize="16"
                           TextColor="Black" />
                    <Label Text="{Binding PropiedadesFormateadas}"
                           FontSize="16"
                           TextColor="Black" />

                    <Label Text="{Binding Precio, StringFormat='Precio: Bs {0:F2}'}"
                           FontSize="16"
                           TextColor="Black" />

                    <Label Text="{Binding Stock, StringFormat='Stock: {0}'}"
                           FontSize="16"
                           TextColor="Black" />

                    <!-- Botón grande "Cerrar" al final -->
                    <Frame CornerRadius="10"
                           BackgroundColor="#5779EA"
                           HasShadow="True"
                           Padding="0"
                           HeightRequest="34"
                           WidthRequest="236"
                           HorizontalOptions="Center">
                        <Grid VerticalOptions="Center" HorizontalOptions="Center">
                            <Button Text="Cerrar"
                                    BackgroundColor="#5779EA"
                                    TextColor="White"
                                    FontSize="15"
                                    FontAttributes="Bold"
                                    FontFamily="Inter"
                                    CornerRadius="10"
                                    Padding="0"
                                    Clicked="BtnCerrar_Clicked" />
                        </Grid>
                    </Frame>

                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
