<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:MauiAppGestorMovil.Views"
             xmlns:viewcontrols="clr-namespace:MauiAppGestorMovil.Views.Controls"
             x:Class="MauiAppGestorMovil.Views.SeleccionarCategoriaProducto"
             BackgroundColor="#849EDE">

    <!-- ========================================================
         Grid principal con dos filas:
         - Fila 0 (*) → contenido principal (scrollable)
         - Fila 1 (Auto) → barra de botones
         Padding general: 20
    ======================================================== -->
    <Grid RowDefinitions="*,Auto" Padding="20">

        <!-- ========================================================
             ScrollView que contiene lista de categorías y subcategorías
        ======================================================== -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="20">

                <!-- Encabezado estándar reutilizable con título dinámico -->
                <views:EncabezadoEmpresa TituloPagina="Seleccionar Categoría del Nuevo Producto"/>

                <!-- ========================================================
                     CollectionView de categorías jerárquicas
                     - ItemsSource enlazado al ObservableCollection del VM
                     - SelectionMode Single → solo un nodo seleccionado
                     - SelectedItem enlazado a CategoriaNodoSeleccionada (TwoWay)
                ======================================================== -->
                <CollectionView ItemsSource="{Binding CategoriasJerarquicas}"
                                SelectionMode="Single"
                                SelectedItem="{Binding CategoriaNodoSeleccionada, Mode=TwoWay}">
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <!-- 🔹 Frame transparente para capturar Tap en toda la tarjeta -->
                            <Frame HasShadow="False" Padding="0" BackgroundColor="Transparent">
                                <Frame.GestureRecognizers>
                                    <!-- TapGesture enlazado al comando del ViewModel -->
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.CategoriaSeleccionadaCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                        CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>

                                <!-- Contenido visual del nodo de categoría -->
                                <viewcontrols:CategoriaItemSeleccionView 
                                    PaddingLeftExtra="0"
                                    CategoriaSeleccionadaCommand="{Binding BindingContext.CategoriaSeleccionadaCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" />
                            </Frame>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ========================================================
             Barra de botones en la parte inferior:
             - HorizontalStackLayout alineado a la derecha
             - Spacing y margen para separación visual
        ======================================================== -->
        <HorizontalStackLayout Grid.Row="1"
                               HorizontalOptions="End"
                               Spacing="10"
                               Margin="0,10,0,0">

            <!-- Botón Continuar -->
            <Button Text="Continuar"
                    BackgroundColor="#5679EA"
                    TextColor="White"
                    FontAttributes="Bold"
                    WidthRequest="100"
                    HeightRequest="40"
                    CornerRadius="5"
                    Command="{Binding ContinuarCommand}"
                    IsEnabled="{Binding CategoriaSeleccionadaHojaValida}" />
            <!-- IsEnabled solo activo si la hoja seleccionada es válida -->

            <!-- Botón Cancelar -->
            <Button Text="Cancelar"
                    BackgroundColor="#DA6533"
                    TextColor="White"
                    FontAttributes="Bold"
                    WidthRequest="100"
                    HeightRequest="40"
                    CornerRadius="5"
                    Command="{Binding CancelarCommand}" />
        </HorizontalStackLayout>

    </Grid>
</ContentPage>
