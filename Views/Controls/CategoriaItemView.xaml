<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrls="clr-namespace:MauiAppGestorMovil.Controls"
             xmlns:viewctrls="clr-namespace:MauiAppGestorMovil.Views.Controls"
             xmlns:page="clr-namespace:MauiAppGestorMovil.Views"
             xmlns:conv="clr-namespace:MauiAppGestorMovil.Converters"
             x:Class="MauiAppGestorMovil.Views.Controls.CategoriaItemView">

    <ContentView.Resources>
        <ResourceDictionary>
            <conv:IntToBoolConverter        x:Key="IntToBoolConverter"/>
            <conv:BoolToFlechaConverter     x:Key="BoolToFlechaConverter"/>
            <conv:IntToThicknessConverter   x:Key="IntToThicknessConverter"/>
            <conv:IntIncrementConverter     x:Key="IntIncrementConverter"/>
        </ResourceDictionary>
    </ContentView.Resources>

    <!-- PaddingLeftExtra controla la sangría según el nivel -->
    <StackLayout Spacing="5"
                 Padding="{Binding PaddingLeftExtra,
                                   Converter={StaticResource IntToThicknessConverter}}">

        <!-- Tarjeta de la categoría -->
        <Frame BackgroundColor="#E1E8FB"
               CornerRadius="10"
               Padding="10"
               HasShadow="True">

            <VerticalStackLayout>

                <!-- Encabezado con nombre truncado y botones -->
                <Grid ColumnDefinitions="*,Auto,Auto,Auto"
                      VerticalOptions="Center">

                    <!-- Nombre (truncado) -->
                    <Label Grid.Column="0"
                           Text="{Binding NombreTruncado}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="Black"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding MostrarNombreCompletoCommand}" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- ➕ Sub  -->
                    <ImageButton Grid.Column="1"
                                 Source="iconosub_01.png"
                                 WidthRequest="50"
                                 HeightRequest="50"
                                 BackgroundColor="Transparent"
                                 Command="{Binding Source={RelativeSource AncestorType={x:Type page:GestionDeCategorias}},
                                                   Path=BindingContext.AgregarSubcategoriaCommand}"
                                 CommandParameter="{Binding .}" />

                    <!-- ✏️ Editar -->
                    <ImageButton Grid.Column="2"
                                 Source="iconoeditar_01.png"
                                 WidthRequest="25"
                                 HeightRequest="25"
                                 BackgroundColor="Transparent"
                                 Command="{Binding Source={RelativeSource AncestorType={x:Type page:GestionDeCategorias}},
                                                   Path=BindingContext.EditarCategoriaCommand}"
                                 CommandParameter="{Binding .}" />

                    <!-- 🗑️ Eliminar -->
                    <ImageButton Grid.Column="3"
                                 Source="iconoeliminar_01.png"
                                 WidthRequest="25"
                                 HeightRequest="25"
                                 BackgroundColor="Transparent"
                                 Command="{Binding Source={RelativeSource AncestorType={x:Type page:GestionDeCategorias}},
                                                   Path=BindingContext.EliminarCategoriaCommand}"
                                 CommandParameter="{Binding .}" />
                </Grid>

                <!-- Bloque de subcategorías -->
                <StackLayout Padding="10,5,0,0"
                             Spacing="5"
                             IsVisible="{Binding Subcategorias.Count,
                                                 Converter={StaticResource IntToBoolConverter}}">

                    <!-- Encabezado expandible -->
                    <Grid ColumnDefinitions="Auto,*"
                          VerticalOptions="Center">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleExpandCommand}" />
                        </Grid.GestureRecognizers>

                        <Label Grid.Column="0"
                               Text="{Binding EstaExpandida,
                                              Converter={StaticResource BoolToFlechaConverter}}"
                               FontSize="13"
                               TextColor="#888888"
                               VerticalOptions="Center"
                               Padding="0,0,5,0" />

                        <Label Grid.Column="1"
                               Text="Subcategorías:"
                               FontSize="13"
                               FontAttributes="Italic"
                               TextColor="#888888"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- Recursión -->
                    <CollectionView ItemsSource="{Binding Subcategorias}"
                                    IsVisible="{Binding EstaExpandida}"
                                    SelectionMode="None"
                                    Margin="10,0,0,0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <viewctrls:CategoriaItemView
                                    PaddingLeftExtra="{Binding Source={RelativeSource AncestorType={x:Type viewctrls:CategoriaItemView}},
                                                               Path=PaddingLeftExtra,
                                                               Converter={StaticResource IntIncrementConverter}}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

            </VerticalStackLayout>
        </Frame>
    </StackLayout>
</ContentView>
