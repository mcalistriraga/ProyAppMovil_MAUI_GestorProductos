<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppGestorMovil.Views.Controls.CategoriaItemSeleccionView">
    <StackLayout Padding="{Binding PaddingLeftExtra}">
        <Label Text="{Binding Categoria.NombreTruncado}">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding BindingContext.SeleccionarCategoriaCommand, Source={x:Reference RootPage}}"
                                      CommandParameter="{Binding .}" />
            </Label.GestureRecognizers>
        </Label>
    </StackLayout>
</ContentView>

