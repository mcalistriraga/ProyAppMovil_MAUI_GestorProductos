<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ctrls="clr-namespace:MauiAppGestorMovil.Controls"
             xmlns:viewctrls="clr-namespace:MauiAppGestorMovil.Views.Controls"
             xmlns:conv="clr-namespace:MauiAppGestorMovil.Converters"
             x:Class="MauiAppGestorMovil.Views.Controls.CategoriaItemSeleccionView">

    <!-- ========================================================
         Recursos de conversión usados en bindings:
         - IntToBoolConverter → convierte count > 0 a True/False
         - BoolToFlechaConverter → controla el ícono de expandir/contraer
         - IntToThicknessConverter → transforma nivel de sangría a Padding
         - IntIncrementConverter → incrementa la sangría para subniveles
    ======================================================== -->
    <ContentView.Resources>
        <ResourceDictionary>
            <conv:IntToBoolConverter        x:Key="IntToBoolConverter"/>
            <conv:BoolToFlechaConverter     x:Key="BoolToFlechaConverter"/>
            <conv:IntToThicknessConverter   x:Key="IntToThicknessConverter"/>
            <conv:IntIncrementConverter     x:Key="IntIncrementConverter"/>
        </ResourceDictionary>
    </ContentView.Resources>

    <!-- StackLayout principal con sangría según el nivel de la categoría -->
    <StackLayout Spacing="5"
                 Padding="{Binding PaddingLeftExtra,
                                   Converter={StaticResource IntToThicknessConverter}}">

        <!-- Frame principal de la categoría -->
        <Frame BackgroundColor="#E1E8FB"
               CornerRadius="10"
               Padding="10"
               HasShadow="True">

            <VerticalStackLayout>

                <!-- Encabezado: nombre de la categoría (truncado si es muy largo) -->
                <Grid ColumnDefinitions="*,Auto"
                      VerticalOptions="Center">

                    <Label Grid.Column="0"
                           Text="{Binding NombreTruncado}"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="Black"
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <!-- TapGesture: ejecuta el comando de selección definido en el ViewModel -->
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" />
                        </Label.GestureRecognizers>
                    </Label>

                </Grid>

                <!-- Sección de subcategorías (visible solo si hay al menos una) -->
                <StackLayout Padding="10,5,0,0"
                             Spacing="5"
                             IsVisible="{Binding Subcategorias.Count,
                                                 Converter={StaticResource IntToBoolConverter}}">

                    <!-- Encabezado expandible de subcategorías -->
                    <Grid ColumnDefinitions="Auto,*"
                          VerticalOptions="Center">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ToggleExpandCommand}" />
                        </Grid.GestureRecognizers>

                        <!-- Flecha para expandir/contraer -->
                        <Label Grid.Column="0"
                               Text="{Binding EstaExpandida,
                                              Converter={StaticResource BoolToFlechaConverter}}"
                               FontSize="13"
                               TextColor="#888888"
                               VerticalOptions="Center"
                               Padding="0,0,5,0" />

                        <Label Grid.Column="1"
                               Text="Subcategorías:"
                               FontSize="13"
                               FontAttributes="Italic"
                               TextColor="#888888"
                               VerticalOptions="Center" />
                    </Grid>

                    <!-- CollectionView recursiva para subcategorías -->
                    <CollectionView ItemsSource="{Binding Subcategorias}"
                                    IsVisible="{Binding EstaExpandida}"
                                    SelectionMode="None"
                                    Margin="10,0,0,0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <viewctrls:CategoriaItemSeleccionView
                                    PaddingLeftExtra="{Binding Source={RelativeSource AncestorType={x:Type viewctrls:CategoriaItemSeleccionView}},
                                                               Path=PaddingLeftExtra,
                                                               Converter={StaticResource IntIncrementConverter}}"
                                    CategoriaSeleccionadaCommand="{Binding BindingContext.CategoriaSeleccionadaCommand,
                                                                           Source={RelativeSource AncestorType={x:Type ContentPage}}}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </StackLayout>

            </VerticalStackLayout>
        </Frame>
    </StackLayout>
</ContentView>
